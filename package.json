{
  "name": "i",
  "productName": "I",
  "storageIdentity": "I",
  "version": "0.1.0",
  "type": "module",
  "description": "Desktop coding agent built on the existing ts-agent core, powered by React + Electron + TypeScript",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "node scripts/macos-app.mjs dev",
    "build": "electron-vite build",
    "preview": "node scripts/macos-app.mjs preview",
    "package:mac": "npm run build && node scripts/macos-app.mjs package",
    "dmg:mac": "npm run build && node scripts/macos-app.mjs dmg",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:canvas": "tsc --noEmit --emitDeclarationOnly false -p canvas/engine/editor/tsconfig.json",
    "typecheck:tests": "tsc -p tsconfig.tests.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:canvas && npm run typecheck:tests",
    "test": "TSX_TSCONFIG_PATH=tsconfig.web.json node --import tsx --test 'tests/**/*.test.ts'",
    "setup:attachments": "node scripts/setup-attachments.mjs",
    "agent:cli": "npx tsx agent/run.ts"
  },
  "dependencies": {
    "@braintree/sanitize-url": "6.0.2",
    "@napi-rs/canvas": "1.0.13",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-tabs": "1.0.2",
    "@vscode/ripgrep": "1.18.0",
    "browser-fs-access": "0.29.1",
    "clsx": "1.1.1",
    "es6-promise-pool": "2.5.0",
    "fast-xml-parser": "5.11.2",
    "fflate": "0.8.3",
    "fractional-indexing": "3.2.0",
    "image-blob-reduce": "3.0.1",
    "jotai": "2.11.0",
    "jotai-scope": "0.7.2",
    "linkedom": "0.18.14",
    "lodash.debounce": "4.0.8",
    "lodash.throttle": "4.1.1",
    "nanoid": "3.3.3",
    "open-color": "1.9.1",
    "openai": "^6.40.0",
    "pako": "2.0.3",
    "pdfjs-dist": "6.4.299",
    "perfect-freehand": "1.2.0",
    "pica": "7.1.1",
    "png-chunk-text": "1.0.0",
    "png-chunks-encode": "1.0.0",
    "png-chunks-extract": "1.0.0",
    "points-on-curve": "1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "roughjs": "4.6.4",
    "tunnel-rat": "0.1.2",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^22.0.0",
    "@types/pako": "^2.0.4",
    "@types/pica": "^9.0.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "sass": "1.104.1",
    "tsx": "^4.22.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  }
}
