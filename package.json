{
  "name": "agent-studio",
  "version": "0.1.0",
  "type": "module",
  "description": "Desktop coding agent built on the existing ts-agent core, powered by React + Electron + TypeScript",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "install-electron --no",
    "dev": "electron-vite dev --watch",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "TSX_TSCONFIG_PATH=tsconfig.web.json node --import tsx --test 'tests/**/*.test.ts'",
    "agent:cli": "npx tsx agent/run.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "@google/genai": "^1.52.0",
    "openai": "^6.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^44.0.0",
    "electron-vite": "^5.0.0",
    "tsx": "^4.22.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.6"
  }
}
