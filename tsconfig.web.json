{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@agent-studio/canvas-editor": ["canvas/shims.d.ts"],
      "@agent-studio/canvas-editor/types": ["canvas/shims.d.ts"],
      "@agent-studio/canvas-editor/element/types": ["canvas/shims.d.ts"]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "outDir": "node_modules/.tmp/web",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"]
  },
  "include": ["frontend/**/*", "shell/shared/**/*", "canvas/shims.d.ts"]
}
