{
  "compilerOptions": {
    "outDir": "./dist/types",
    "target": "ESNext",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "allowSyntheticDefaultImports": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "emitDeclarationOnly": true,
    "paths": {
      "@i/canvas-editor": ["../editor/index.tsx"],
      "@i/canvas-utils": ["../utils/index.ts"],
      "@i/canvas-math": ["../math/index.ts"],
      "@i/canvas-editor/*": ["../editor/*"],
      "@i/canvas-utils/*": ["../utils/*"],
      "@i/canvas-math/*": ["../math/*"]
    }
  },
  "exclude": ["**/*.test.*", "tests", "types", "examples", "dist"]
}
